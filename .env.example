# Clerk authentication — https://dashboard.clerk.com/~/api-keys
# On first run without keys, Clerk Keyless mode may auto-provision dev keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Pooled PostgreSQL URL for the app runtime (serverless / connection pooler).
# Without DATABASE_URL, presets continue to use browser localStorage only.
# Neon on Vercel: provided automatically as DATABASE_URL
DATABASE_URL=

# Direct PostgreSQL URL for Prisma migrations (no pooler).
# Required on Vercel so `prisma migrate deploy` can run during build.
# Neon on Vercel: provided automatically as DATABASE_URL_UNPOOLED
# Local: can match DATABASE_URL when not using a pooler.
DATABASE_URL_UNPOOLED=

# Comma-separated Clerk user ids allowed to manage default agent templates
# and list all users. Users with role "admin" in the database are also admins.
ADMIN_USER_IDS=

# Optional secret for POST /api/admin/backfill-agents from curl/CI on Vercel.
# Authorization: Bearer <BACKFILL_SECRET>
BACKFILL_SECRET=
